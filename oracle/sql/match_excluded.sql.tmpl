-- q12: fields that intersect a listed parcel but fail BOTH inclusion tests, so
-- are excluded. Reads the in-memory `decision` table that match.sql leaves in
-- the connection (one row per field, with the two rule flags and the fractions).
-- A field "intersects a listed parcel" if it has any single- or union-overlap.
CREATE OR REPLACE VIEW _q AS
SELECT count(*) AS n_excluded
FROM decision
WHERE (coalesce(max_single_frac, 0) > 0 OR coalesce(union_frac, 0) > 0)
  AND NOT by_primary
  AND NOT by_aggregate;
