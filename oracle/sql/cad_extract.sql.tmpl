-- ---------------------------------------------------------------------------
-- cad_extract.sql.tmpl  →  sql/out/list/<id>/cad_extract.sql
-- Pull the cadastral parcels (CAR) named on this list from the national CAR
-- parquet. The list is a CSV with a cod_imovel column; we keep the parcels'
-- legal-status columns (ind_status/des_condic) for the EUDR legality panel.
--
-- Source : tristangruppwri/cadastral/Brazil_CAR_AREA_IMOVEL.parquet (8.45M rows)
-- Placeholders: ${LIST_CSV} ${ID_COLUMN} ${CAR_URL} ${CAD_PARQUET}
--
-- State pre-filter: cod_imovel is "UF-<ibge>-<uuid>", so the state prefixes on
-- the list give the UFs it covers. Filtering cod_estado to those first lets a
-- reader with row-group statistics on cod_estado skip the ~19/20 of Brazil the
-- list does not touch, before the exact cod_imovel IN selection. Output is
-- identical to the ID-only filter (every listed id is in one of those states).
--
-- NOTE: as of 2026-07, this CAR parquet ships WITHOUT a bbox covering column
-- (unlike trazofields), so a spatial ST_Intersects(envelope) filter cannot skip
-- row groups — it degrades to a full geometry scan. Republishing the file with
-- bbox covering + Hilbert clustering is what turns this extract from a multi-GB
-- scan into reading a handful of row groups; the state pre-filter below is the
-- best available lever until then.
-- ---------------------------------------------------------------------------
INSTALL httpfs; LOAD httpfs;
INSTALL spatial; LOAD spatial;

CREATE OR REPLACE TABLE list AS
SELECT DISTINCT CAST(${ID_COLUMN} AS VARCHAR) AS cod_imovel
FROM read_csv_auto('${LIST_CSV}');

-- The CAR file is EPSG:4674 (SIRGAS 2000); Trazo fields are EPSG:4326 (WGS84).
-- The two datums differ <1 m in Brazil, immaterial for the containment ratios
-- and envelope clips downstream, so relabel to 4326 with ST_SetCRS (a
-- metadata-only override, no coordinate transform) rather than reproject. This
-- also lets DuckDB's CRS-strict spatial functions accept CAR ∩ Trazo directly.
CREATE OR REPLACE TABLE cad AS
SELECT cod_imovel, municipio, cod_estado, num_area, mod_fiscal,
       ind_status, ind_tipo, des_condic, dat_criaca, dat_atuali,
       ST_SetCRS(geometry, 'EPSG:4326') AS geometry
FROM read_parquet('${CAR_URL}')
WHERE cod_estado IN (SELECT DISTINCT split_part(cod_imovel, '-', 1) FROM list)
  AND cod_imovel IN (SELECT cod_imovel FROM list);

COPY cad TO '${CAD_PARQUET}' (FORMAT PARQUET);

-- Console check: every listed ID should resolve to a CAR parcel.
SELECT (SELECT count(*) FROM list) AS list_ids,
       (SELECT count(*) FROM cad)  AS found_in_car,
       (SELECT count(*) FROM list) - (SELECT count(*) FROM cad) AS missing;
