-- ---------------------------------------------------------------------------
-- cad_extract.sql.tmpl  →  sql/out/list/<id>/cad_extract.sql
-- Pull the cadastral parcels (CAR) the list resolves to. list_resolve has
-- already turned the raw list into a canonical id set and cached the CAR slice
-- those ids live in, so this stage is a local selection; we keep the parcels'
-- legal-status columns (ind_status/des_condic) for the EUDR legality panel.
--
-- Source : tristangruppwri/cadastral/brazil-car-area-imovel/
--          brazil_car_area_imovel.parquet (8,453,552 rows)
-- Placeholders: ${RESOLVED_PARQUET} ${CAR_STATE_PARQUET} ${CAD_PARQUET}
--
-- The list is no longer read here, and no longer read with SELECT DISTINCT.
-- That distinct collapsed duplicate ids before anything could count them, which
-- made the reconciliation identity in SPEC.md §4 unmeasurable: a
-- silently dropped row and a correctly deduplicated one produced the same
-- extract. RESOLVED_PARQUET carries one row per input row with the rule it
-- landed on, and this stage takes the parcels behind them.
--
-- NOTE: the CAR parquet was republished on 2026-08-02 with the bbox covering
-- column it previously lacked, so a predicate written against bbox now prunes
-- row groups. Its string columns still carry no min/max statistics, so the
-- state pre-filter in list_resolve narrows rows without narrowing the read.
-- Rewriting that pre-filter to prune is issue #10; nothing in this stage is
-- affected either way, because it selects from the cached local slice.
-- ---------------------------------------------------------------------------
INSTALL httpfs; LOAD httpfs;
INSTALL spatial; LOAD spatial;

-- CAR geometry is longitude-first. Nothing in this file is axis-sensitive
-- today (envelopes and centroids are not), but the extract feeds every
-- downstream stage, so it declares the same axis order they assume.
SET geometry_always_xy = true;

CREATE OR REPLACE TABLE list AS
SELECT DISTINCT cod_imovel
FROM read_parquet('${RESOLVED_PARQUET}')
WHERE cod_imovel IS NOT NULL;

-- Geometry arrives as EPSG:4326: the republished CAR file is reprojected on
-- disk, so no relabel happens upstream any more. See list_resolve.
CREATE OR REPLACE TABLE cad AS
SELECT cod_imovel, municipio, cod_estado, num_area, mod_fiscal,
       ind_status, ind_tipo, des_condic, dat_criaca, dat_atuali, geometry
FROM read_parquet('${CAR_STATE_PARQUET}')
WHERE cod_imovel IN (SELECT cod_imovel FROM list);

COPY cad TO '${CAD_PARQUET}' (FORMAT PARQUET);

-- Console check: every listed ID should resolve to a CAR parcel.
SELECT (SELECT count(*) FROM list) AS list_ids,
       (SELECT count(*) FROM cad)  AS found_in_car,
       (SELECT count(*) FROM list) - (SELECT count(*) FROM cad) AS missing;
