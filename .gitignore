# uv environment
.venv/

# coverage artifacts
.coverage
coverage.xml
htmlcov/
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/

# Credentials. Sessions mount a copy of the host login (see harness/run.py);
# nothing token-shaped belongs in this history. scripts/check_credentials.py
# enforces this on content too, since results/ transcripts are committed.
.credentials.json
**/.credentials.json
.claude/
*.pem
.env
.env.*

# results ARE committed for auditability — do not ignore results/

# Oracle intermediate extracts (regenerable; the cold source.coop pull)
fixtures/golden/_work/

# MCP tool caches, local to a checkout
.serena/

# Downloaded by `vale sync`; .vale.ini pins the package release.
styles/Google/
styles/Microsoft/
styles/Readability/

# A session that stages the CAR file locally builds a DuckDB database in
# answers/, and the harness copies that whole directory out. One 2026-09-18
# Opus trial produced a 3.2 GB work.duckdb and GitHub rejected the push at
# its 100 MB file limit. The trial's CSVs, metadata, and transcript are the
# record; the scratch database is not.
results/*/*/answers/*.duckdb
results/*/*/answers/*.duckdb.wal
